# ==============================================================================
# FileVault Configuration
# ==============================================================================

# Server
PORT=5000
NODE_ENV=development
API_URL=http://localhost:5000
FRONTEND_URL=http://localhost:3000

# PostgreSQL Database (Prisma)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/filevault?schema=public"

# Redis (Rate Limiting, Queues, Cache)
REDIS_URL="redis://localhost:6379"

# JWT Authentication
JWT_ACCESS_SECRET="super-secret-access-token-key-change-in-production-min-32-chars"
JWT_REFRESH_SECRET="super-secret-refresh-token-key-change-in-production-min-32-chars"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# Cloudflare R2 Object Storage (S3-compatible)
# Leave blank or omit for local MockStorageProvider during dev
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME="filevault-bucket"
R2_ENDPOINT=""
R2_PUBLIC_URL=""

# Storage Local Mock Dir (Used when R2 is not configured)
STORAGE_LOCAL_DIR="./storage_data"

# Google OAuth (Optional)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_CALLBACK_URL="http://localhost:5000/api/auth/google/callback"

# Email Provider (Optional, defaults to console log in dev)
RESEND_API_KEY=""
EMAIL_FROM="FileVault <noreply@filevault.app>"
